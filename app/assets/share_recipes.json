{
  "recipes": [
    {
      "id": "age_gate_21",
      "label": "Prove I am 21+",
      "category": "Identity",
      "providerIds": ["aadhaar.demographics.v1"],
      "description": "Share only whether your age is at least 21.",
      "selection": {
        "fields": [],
        "predicates": [
          {
            "id": "age_21",
            "label": "Age is at least 21",
            "sourcePath": "$.responseData.dob",
            "transform": "dateToYearsTillNow",
            "op": ">=",
            "value": 21
          }
        ]
      }
    },
    {
      "id": "employment_status",
      "label": "Prove employment",
      "category": "Professional",
      "providerIds": ["gusto.employees.v1"],
      "description": "Share your employer name and prove the employment record exists.",
      "selection": {
        "fields": [
          {
            "path": "$.responseData.companyName",
            "label": "Employer"
          }
        ],
        "predicates": [
          {
            "id": "employment_exists",
            "label": "Employment record exists",
            "sourcePath": "$.responseData.companyName",
            "transform": "identity",
            "op": "truthy",
            "value": true
          }
        ]
      }
    },
    {
      "id": "income_threshold",
      "label": "Prove income range",
      "category": "Professional",
      "providerIds": ["deel.paystubs.v1"],
      "description": "Prove pay is above a threshold without revealing the exact value.",
      "selection": {
        "fields": [],
        "predicates": [
          {
            "id": "pay_above_threshold",
            "label": "Pay is at least 1000",
            "sourcePath": "$.responseData.amount",
            "transform": "parseNumber",
            "op": ">=",
            "value": 1000
          }
        ]
      }
    },
    {
      "id": "account_ownership",
      "label": "Prove account ownership",
      "category": "Social",
      "providerIds": ["kaggle.current_user.v1"],
      "description": "Share the public profile handle and prove the account exists.",
      "selection": {
        "fields": [
          {
            "path": "$.responseData.userName",
            "label": "Username"
          },
          {
            "path": "$.responseData.userId",
            "label": "User ID"
          },
          {
            "path": "$.responseData.userJoinDate",
            "label": "Joined"
          }
        ],
        "predicates": [
          {
            "id": "account_exists",
            "label": "Account exists",
            "sourcePath": "$.responseData.userName",
            "transform": "identity",
            "op": "truthy",
            "value": true
          }
        ]
      }
    },
    {
      "id": "travel_activity",
      "label": "Prove ride activity",
      "category": "Social",
      "providerIds": ["uber.past_activities.v1"],
      "description": "Prove the account has ride activity without revealing the full trip history.",
      "selection": {
        "fields": [],
        "predicates": [
          {
            "id": "ride_activity_exists",
            "label": "Ride activity exists",
            "sourcePath": "$.responseData.activities",
            "transform": "length",
            "op": ">",
            "value": 0
          }
        ]
      }
    },
    {
      "id": "recent_food_order",
      "label": "Prove recent food order",
      "category": "Social",
      "providerIds": ["swiggy.orders.v1"],
      "description": "Share a receipt-style proof for the latest Swiggy order.",
      "selection": {
        "fields": [
          {
            "path": "$.data.total_orders",
            "label": "Total orders"
          },
          {
            "path": "$.data.orders[0].order_delivery_status",
            "label": "Delivery status"
          },
          {
            "path": "$.data.orders[0].restaurant_name",
            "label": "Restaurant"
          },
          {
            "path": "$.data.orders[0].order_time",
            "label": "Order time"
          },
          {
            "path": "$.data.orders[0].order_total_with_tip",
            "label": "Total paid"
          },
          {
            "path": "$.data.orders[0].delivery_address.address",
            "label": "Delivery address"
          },
          {
            "path": "$.data.orders[0].payment_method",
            "label": "Payment method"
          }
        ],
        "predicates": []
      }
    },
    {
      "id": "swiggy_expense_receipt_lite",
      "label": "Expense receipt lite",
      "category": "Money",
      "providerIds": ["swiggy.orders.v1"],
      "description": "Share only the restaurant, time, amount, and payment mode for meal reimbursement.",
      "selection": {
        "fields": [
          {
            "path": "$.data.orders[0].restaurant_name",
            "label": "Restaurant"
          },
          {
            "path": "$.data.orders[0].order_time",
            "label": "Order time"
          },
          {
            "path": "$.data.orders[0].order_total_with_tip",
            "label": "Total paid"
          },
          {
            "path": "$.data.orders[0].payment_method",
            "label": "Payment method"
          }
        ],
        "predicates": [
          {
            "id": "swiggy_order_delivered_for_expense",
            "label": "Order was delivered",
            "sourcePath": "$.data.orders[0].order_delivery_status",
            "transform": "identity",
            "op": "==",
            "value": "Delivered"
          }
        ]
      }
    },
    {
      "id": "swiggy_delivery_confirmation",
      "label": "Delivery confirmation",
      "category": "Social",
      "providerIds": ["swiggy.orders.v1"],
      "description": "Prove the latest order was delivered while keeping address, payment, and full receipt hidden.",
      "selection": {
        "fields": [
          {
            "path": "$.data.orders[0].restaurant_name",
            "label": "Restaurant"
          },
          {
            "path": "$.data.orders[0].order_time",
            "label": "Order time"
          }
        ],
        "predicates": [
          {
            "id": "swiggy_latest_order_delivered",
            "label": "Latest order was delivered",
            "sourcePath": "$.data.orders[0].order_delivery_status",
            "transform": "identity",
            "op": "==",
            "value": "Delivered"
          }
        ]
      }
    }
  ]
}
