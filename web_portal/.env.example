PORT=8081
HOST=0.0.0.0
BASE_URL=http://localhost:8081

# Origin of the share_service API. The portal makes cross-origin fetch
# calls to this base, so share_service must include this origin in
# CORS_ALLOWED_ORIGIN (or use '*'). For LAN access from a real phone,
# set this to the share_service URL on your machine's IP.
SHARE_SERVICE_URL=http://localhost:8080
