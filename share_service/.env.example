# Required. 32-byte base64 envelope key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY_B64=REPLACE_WITH_32_BYTE_BASE64_KEY

# Required. TLSN verifier service endpoint.
VERIFIER_URL=http://localhost:7047

# Required. Origin of the recipient frontend (web_portal). Share URLs
# minted by /shares point here; the portal fetches back into this
# service across origins.
PORTAL_BASE_URL=http://localhost:8081

# Optional. Defaults to 8080. On Fly.io the platform injects PORT.
# PORT=8080

# Optional. Where the FileStore writes blobs + JSON state.
# Defaults to <share_service>/data locally; set to /data on Fly.io
# so it lands on the mounted persistent volume.
# DATA_DIR=./data
